# Gmail OAuth
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/inboxes/oauth/callback

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Database
DATABASE_URL=sqlite:///./data/outbound.db

# Security
SECRET_KEY=your_secret_key_for_encryption_generate_with_openssl_rand_hex_32

# App Settings
DEBUG=true
LOG_LEVEL=INFO

# Frontend URL - used for links in the reply agent's email alerts
APP_BASE_URL=http://localhost:5173

# Google Maps scraper (Places API (New) key) - or paste it on the Scrapers page
GOOGLE_MAPS_API_KEY=

# Accounts & sign-in
# Data created before accounts existed is assigned to this account on first start
INITIAL_OWNER_EMAIL=
# Set to true when the app is served over HTTPS
SESSION_COOKIE_SECURE=false
# Must also be listed under the OAuth client's "Authorized redirect URIs" in Google Cloud Console
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# Frontend URL(s) allowed to call the API, comma-separated
CORS_ORIGINS=http://localhost:5173

# Background worker: auto (separate worker on Vercel, inside the API locally), in_process or external
BACKGROUND_WORKER=auto
# How often the worker checks for new jobs, in seconds (10 on free hosting plans)
JOB_POLL_SECONDS=1
